#!/usr/bin/env bash
# Own only explicitly selected marks. Never flush ranges of RPDB rules/tables.
# Teach networkd about our rules so DHCP/reloads/package upgrades retain them.
set -euo pipefail
export LC_ALL=C
. /etc/default/nfqueue-router
BIN=/usr/local/bin/nfqueue-router
BASE_TABLE=1100
BASE_PRIO=10100
[ "${1:-apply}" = apply ] || { echo 'Usage: nfqueue-router-policy apply [--no-networkd]' >&2; exit 2; }
[ "$#" -le 2 ] && [ "${2:-}" = '' -o "${2:-}" = --no-networkd ] || exit 2
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
"$BIN" list --fake-cidr "$FAKE_CIDR" --domains-dir "$DOMAINS_DIR" > "$work/list"
awk 'NR > 1 && !seen[$3]++ { print $3, $2 }' "$work/list" > "$work/marks"
printf '# Generated by nfqueue-router-policy; do not edit.\n' > "$work/networkd"

# Preflight all priorities before making changes. A priority collision must not
# remove somebody else's rule, even if its number is in our historical range.
ip -details -j -4 rule show > "$work/rules.json"
python3 - "$work/rules.json" "$work/marks" "$work/static-marks" <<'PY'
import json,sys
rules=json.load(open(sys.argv[1])); static=set()
for line in open(sys.argv[2]):
    mark,iface=line.split(); mark=int(mark,0); idx=mark & 0xffff
    for r in rules:
        if r['priority'] != 10100+idx: continue
        raw=r.get('fwmark',0); fw=int(raw,0) if isinstance(raw,str) else raw
        raw=r.get('fwmask',0xffffffff); mask=int(raw,0) if isinstance(raw,str) else raw
        raw=r.get('table',0); table=int(raw) if str(raw).isdigit() else raw
        if (fw != mark or mask != 0xffffffff or table != 1100+idx
            or r.get('src','all') != 'all' or r.get('dst','all') != 'all'
            or any(k in r for k in ('iif','oif','ipproto','sport','dport','not','uidrange','suppress_prefixlength'))):
            raise SystemExit(f'Refusing conflicting routing rule at priority {r["priority"]}: {r}')
        if r.get('protocol') in ('static', 4, '4'): static.add(hex(mark))
with open(sys.argv[3],'w') as out: out.write(''.join(m+'\n' for m in sorted(static)))
PY
while read -r mark iface; do
  idx=$((mark & 0xffff)); table=$((BASE_TABLE + idx)); prio=$((BASE_PRIO + idx))
  if [ "$iface" = "$DEFAULT_IF" ]; then
    gw=$(ip -4 route show default dev "$DEFAULT_IF" | awk '/default/ { print $3; exit }')
    if [ -n "$gw" ]; then
      ip -4 route replace default via "$gw" dev "$iface" table "$table" proto static
    else
      ip -4 route replace default dev "$iface" table "$table" proto static
    fi
  else
    ip -4 route replace default dev "$iface" table "$table" proto static
  fi
  # protocol=static matches networkd's configured rule identity. Leave a legacy
  # protocol=unspec duplicate for networkd to retire after reload: ip rule del
  # protocol unspec is a WILDCARD and could also remove the new static rule.
  if ! grep -Fxq "$mark" "$work/static-marks"; then
    ip -4 rule add priority "$prio" fwmark "$mark"/0xffffffff table "$table" protocol static
  fi
  cat >> "$work/networkd" <<EOF

[RoutingPolicyRule]
Family=ipv4
FirewallMark=$mark/0xffffffff
Table=$table
Priority=$prio
EOF
done < "$work/marks"

if [ "${2:-}" = --no-networkd ] || ! systemctl is-active --quiet systemd-networkd; then exit 0; fi
network=$(networkctl status "$DEFAULT_IF" --no-pager -n 0 | awk '$1 == "Network" && $2 == "File:" { print $3; exit }')
case "$network" in /*.network) ;; *) echo "Cannot identify networkd configuration for $DEFAULT_IF" >&2; exit 1;; esac
dropdir=/etc/systemd/network/$(basename "$network").d
dropfile=$dropdir/90-nfqueue-router.conf
if [ -e "$dropfile" ] && ! grep -q '^# Generated by nfqueue-router-policy;' "$dropfile"; then
  echo "Refusing to overwrite unmanaged file: $dropfile" >&2; exit 1
fi
if ! cmp -s "$work/networkd" "$dropfile"; then
  install -d -m 0755 "$dropdir"
  install -m 0644 "$work/networkd" "$dropfile.tmp"
  mv -f "$dropfile.tmp" "$dropfile"
  # Reload .network files without restarting the daemon. networkd may renew
  # the managed interface's DHCP lease when applying the changed drop-in.
  networkctl reload
fi
