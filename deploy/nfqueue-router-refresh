#!/usr/bin/env bash
# Own only this nft table. Do not flush unrelated firewall rules or erase maps
# during ordinary daemon restarts.
set -euo pipefail
. /etc/default/nfqueue-router
file=/etc/nfqueue-router/nfqueue-router.nft
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cat > "$tmp" <<EOF
table inet nfqueue_router {
  map fake_to_real { type ipv4_addr : ipv4_addr; }
  map fake_to_mark { type ipv4_addr : mark; }
  chain preroute_dns {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "$INPUT_IF" meta l4proto { tcp, udp } th dport 53 counter redirect to :53
  }
  chain preroute_mark {
    type filter hook prerouting priority raw; policy accept;
    iifname "$INPUT_IF" ip daddr $FAKE_CIDR counter meta mark set ip daddr map @fake_to_mark return
    iifname "$INPUT_IF" ip daddr $FAKE_CIDR counter drop comment "unknown fake IP: no conntrack null binding"
  }
  chain preroute_dnat {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "$INPUT_IF" ip daddr $FAKE_CIDR counter dnat ip to ip daddr map @fake_to_real
  }
  chain forward_guard {
    type filter hook forward priority filter - 10; policy accept;
    iifname "$INPUT_IF" ip daddr $FAKE_CIDR counter drop comment "unmapped fake IP must not escape"
  }
  chain forward_mss {
    type filter hook forward priority mangle; policy accept;
    iifname "$INPUT_IF" oifname "$WG_IF" tcp flags syn tcp option maxseg size set 1200
    iifname "$WG_IF" oifname "$INPUT_IF" tcp flags syn tcp option maxseg size set 1200
  }
  chain postrouting_nat {
    type nat hook postrouting priority srcnat; policy accept;
    iifname "$INPUT_IF" oifname "$WG_IF" ip saddr $CLIENT_CIDR counter masquerade
    iifname "$INPUT_IF" oifname "$DEFAULT_IF" ip saddr $CLIENT_CIDR counter masquerade
  }
}
EOF
install -m 0644 "$tmp" "$file"
if /usr/sbin/nft list map inet nfqueue_router fake_to_mark >/dev/null 2>&1 && [ "${1:-}" != --force ]; then
  exit 0
fi
if /usr/sbin/nft list table inet nfqueue_router >/dev/null 2>&1; then
  { echo 'delete table inet nfqueue_router'; printf 'include "%s"\n' "$file"; } > "$tmp"
else
  printf 'include "%s"\n' "$file" > "$tmp"
fi
/usr/sbin/nft --check -f "$tmp"
/usr/sbin/nft -f "$tmp"
